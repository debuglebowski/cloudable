# Control plane
DATABASE_URL=postgres://cloudable:cloudable@localhost:5442/cloudable
PORT=3000
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:3000

# Cloud provider federation (see docs/cloud-auth.md) — must be the public URL
# a customer's Azure federated identity credential is configured to trust.
FEDERATION_ISSUER_URL=http://localhost:3000
FEDERATION_AUDIENCE=api://AzureADTokenExchange

# Agent (dev/local join-token flow — see docs/agents.md)
CONTROL_PLANE_URL=http://localhost:3000
MACHINE_TOKEN=

# CLI
CLOUDABLE_API_URL=http://localhost:3000
