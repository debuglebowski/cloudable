# Control plane
DATABASE_URL=postgres://cloudable:cloudable@localhost:5442/cloudable
PORT=4780
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:4780
# The console's own origin, for CORS - a login session cookie only crosses
# this boundary if the server explicitly allows it.
CONSOLE_ORIGIN=http://localhost:5180

# Where a Local Docker machine's agent reaches this control-plane from
# inside its container. host.docker.internal (not localhost) is the
# container's own host — works out of the box on Docker Desktop.
LOCAL_DOCKER_CONTROL_PLANE_URL=http://host.docker.internal:4780

# Azure — this deployment's own subscription, via its own managed identity
# (DefaultAzureCredential: `az login` locally, Container App managed identity
# in production). One subscription for the whole deployment, not per-org —
# see docs/cloud-auth.md. Leave unset to run without Azure at all (Docker/Fake
# still work); set all three to make "azure" a selectable provider on the
# Integrations page and enable the org-level Azure region catalog sync.
# AZURE_SUBSCRIPTION_ID=
# AZURE_MACHINES_RESOURCE_GROUP=rg-cloudable-managed
# AZURE_MACHINES_SUBNET_ID=

# This control plane's own publicly reachable base URL — the real Azure
# adapter gives this to a new machine's cloud-init as the URL it curls its
# agent/tunnel-daemon binaries from and its CONTROL_PLANE_URL. Only matters
# once AZURE_SUBSCRIPTION_ID etc. above are set; defaults to localhost.
CONTROL_PLANE_BASE_URL=http://localhost:4780

# Agent (dev/local join-token flow — see docs/agents.md)
CONTROL_PLANE_URL=http://localhost:4780
MACHINE_TOKEN=

# CLI
CLOUDABLE_API_URL=http://localhost:4780
