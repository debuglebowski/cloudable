# Copy this file to `.env` (in this directory) and fill in real values.
# Never commit the real .env.

# POSTGRES_USER/POSTGRES_PASSWORD are interpolated directly into a postgres://
# connection URI in control-plane.self-host.yml (Compose has no URL-encoding
# function, unlike the Terraform/Bicep templates). Use only characters that are
# safe unencoded in a URI (letters, digits, - _ .) — avoid / : @ ? # and
# similar. `openssl rand -hex 24` is a good generator for this.
POSTGRES_USER=cloudable
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=cloudable

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-value

# Public URL this control plane will be reached at (used by BetterAuth for
# callback/redirect URLs). Update once you know your real hostname.
BETTER_AUTH_URL=http://localhost:3000

PORT=3000

# Image to run. Until Cloudable publishes one to GHCR, build and push your own
# from apps/control-plane (see the header comment in
# control-plane.self-host.yml for a minimal reference Dockerfile).
CONTROL_PLANE_IMAGE=ghcr.io/debuglebowski/cloudable-control-plane:latest
