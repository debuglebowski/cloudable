{
  "name": "cloudable",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:control-plane": "bun --env-file=\"$PWD/.env\" run --cwd apps/control-plane dev",
    "dev:console": "bun run --cwd apps/console dev",
    "build": "bun run --filter '*' build",
    "test:unit": "bun run --filter '*' test:unit",
    "test:integration": "bun run --filter '*' test:integration",
    "test:e2e": "bun --env-file=\"$PWD/.env\" run --cwd apps/e2e test:e2e",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "bun run --cwd packages/schema db:generate",
    "db:migrate": "bun --env-file=\"$PWD/.env\" run --cwd packages/schema db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.0"
  }
}
