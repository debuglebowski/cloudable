{
  "name": "cloudable-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "seed:agent": "bun run scripts/seed-agent.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "seed:functional": "bun run scripts/seed-functional.ts",
    "build": "exit 0",
    "typecheck": "tsc -b",
    "test:unit": "bun test",
    "test:integration": "bun test ./src/services/reconcile-diff.integration.ts",
    "test:integration-check": "bun test $(find . -path './node_modules/*' -prune -o -name '*.integration-check.ts' -print)"
  },
  "dependencies": {
    "@azure/arm-compute": "25.1.1",
    "@azure/arm-network": "38.0.0",
    "@azure/identity": "4.13.2",
    "@cloudable/contracts": "workspace:*",
    "@cloudable/events": "workspace:*",
    "@cloudable/schema": "workspace:*",
    "@cloudable/session-token": "workspace:*",
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "effect": "^3",
    "jose": "6.2.10",
    "postgres": "3.4.9",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "^1.1.14",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "typescript": "^5.7.0"
  }
}
