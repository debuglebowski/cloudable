# Example systemd unit for the Cloudable control agent (spec §8.1).
#
# Install:
#   cp cloudable-agent-linux-<arch> /opt/cloudable/agent
#   cp cloudable-agent.service /etc/systemd/system/cloudable-agent.service
#   printf 'CONTROL_PLANE_URL=https://your-control-plane.example.com\nMACHINE_TOKEN=<join token>\n' \
#     > /etc/cloudable/agent.env
#   chmod 600 /etc/cloudable/agent.env   # it holds the machine's join token
#   systemctl daemon-reload
#   systemctl enable --now cloudable-agent
#
# The agent is pull-only (invariant #7: no inbound access to any machine) —
# it never listens on a socket, so no [Socket] unit or firewall opening is
# needed. `Restart=always` plus the agent's own exponential-backoff-with-
# jitter loop (see docs/agents.md) is what carries it through a control
# plane outage; systemd's job here is just "come back after a crash",
# not retry timing.

[Unit]
Description=Cloudable control agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cloudable/agent.env
ExecStart=/opt/cloudable/agent
Restart=always
RestartSec=5

# Package actions and atomic self-updates need root. Credentials and scanner state
# remain in their existing locations; the updater only changes executable-adjacent files.
User=root
Group=root
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
